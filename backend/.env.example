# ═══════════════════════════════════════════════════════════════
#  Secure Data Portal — Environment Configuration
#  Copy this file to ".env" and fill in real values before deploying.
#  NEVER commit the real .env file to version control.
# ═══════════════════════════════════════════════════════════════

APP_NAME=Secure Data Portal
ENV=production

# ── JWT / Sessions ──
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_48_BYTE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=480
SESSION_IDLE_TIMEOUT_MINUTES=15

# ── Login security ──
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
MIN_PASSWORD_LENGTH=12

# ── MFA ──
MFA_ISSUER_NAME=SecureDataPortal
MFA_REQUIRED=true

# ── IP Allowlist ──────────────────────────────────────────────
# THIS IS WHERE YOU RESTRICT ACCESS TO ONE SPECIFIC OFFICE IP.
# Comma-separated list of IPs and/or CIDR ranges.
#   Single IP:        ALLOWED_IPS=203.0.113.42
#   Multiple IPs:      ALLOWED_IPS=203.0.113.42,198.51.100.7
#   CIDR range:        ALLOWED_IPS=203.0.113.0/24
#   Leave EMPTY during local dev to disable the restriction:
ALLOWED_IPS=

# Set to true only if you are running behind a reverse proxy (nginx, etc.)
# that sets X-Forwarded-For. If you expose this app directly, set to false.
TRUST_PROXY_HEADERS=true

# ── CORS — frontend origins allowed to call this API ──
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── File upload ──
MAX_UPLOAD_SIZE_MB=25
UPLOAD_RETENTION_HOURS=24
