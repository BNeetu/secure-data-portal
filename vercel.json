{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/data/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/audit",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
